@model IEnumerable<vipplussolution.Models.Tours>
<link href="~/css/site.css" rel="stylesheet" />
<table class="table dark">
    <thead>
        <tr>
            <th scope="col">NO</th>
            <th scope="col">TARİH</th>
            <th scope="col">SAAT</th>
            <th scope="col">NEREDEN</th>
            <th scope="col">NEREYE</th>
            <th scope="col">YOLCULAR</th>
            <th scope="col">ACENTA</th>
            <th scope="col">FİYAT</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.tarih</td>
                <td>@item.saat</td>
                <td>@item.nereden</td>
                <td>@item.nereye</td>
                <td>@item.yolcular</td>
                <td>@item.acenta</td>
                <td>@item.fiyat</td>
            </tr>
        }
    </tbody>
</table>
<br />