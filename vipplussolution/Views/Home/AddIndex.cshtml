@model vipplussolution.Models.Tours
<form asp-action="Ekle" asp-controller="Home" method="post">
    <div class="form-group row">
        <div class="col-sm-10">
            <input type="date" class="form-control" asp-for="tarih" placeholder="Tarih" />
            <input type="time" class="form-control" asp-for="saat" placeholder="Saat"/>
            <input type="text" class="form-control" asp-for="nereden" placeholder="Nereden"/>
            <input type="text" class="form-control" asp-for="nereye" placeholder="Nereye"/>
            <input type="text" class="form-control" asp-for="yolcular" placeholder="Yolcular"/>
            <input type="text" class="form-control" asp-for="acenta" placeholder="Acenta"/>
            <input type="number" class="form-control" asp-for="fiyat" placeholder="Fiyat"/>
        </div>
    </div>
</form>
<button class="btn btn-primary" type="submit">Ekle</button>
